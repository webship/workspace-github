{
  "name": "@webship.co/workspace-github",
  "version": "1.0.14",
  "description": "GitHub for Webship Workspace: the GITHUB menu on every project whose remote is on github.com (repository, issues, pull requests, open one from the branch), the repository chip, clone when a new folder is made, the credential gh-based work uses from the dashboard, and its AI items in their folders: an agent, a skill, a command and a prompt. A provider of @webship.co/workspace-forge.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-github.git"
  },
  "files": [
    "dist/src",
    "ai",
    "config",
    "docs",
    "features",
    "scripts",
    "README.md",
    "ddev",
    "host-mounts.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "github",
    "label": "GitHub",
    "needs": {
      "plugins": [
        "ai-agents",
        "ai-skills",
        "ai-commands",
        "ai-prompts"
      ],
      "commands": [
        {
          "command": "gh",
          "hint": "https://cli.github.com"
        }
      ]
    },
    "settingsFile": "plugin.github.settings.yml",
    "settingsTemplate": "config/plugin.github.settings.yml",
    "labels": "config/settings.labels.yml",
    "legacySettingsKey": "git.github",
    "scripts": {
      "hostInstall": "scripts/host-install.sh"
    },
    "ai": {
      "agents": [
        "ai/agents/github-issue-pr-worker.md"
      ],
      "skills": [
        "ai/skills/github-forge"
      ],
      "commands": [
        "ai/commands/github-status.md"
      ],
      "prompts": [
        "ai/prompts/github-issue-to-pr.md"
      ]
    },
    "features": [
      "features/github.feature"
    ],
    "ddev": {
      "compose": [
        "ddev/docker-compose.github-cli.yaml"
      ],
      "hostMounts": [
        "~/.config/gh"
      ]
    }
  },
  "dependencies": {
    "@webship.co/workspace-forge": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.2",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
